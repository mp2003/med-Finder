# From @BotFather. Revoke and reissue if this value ever leaves your machine.
BOT_TOKEN=paste-here

# A SECOND bot from @BotFather, used by `python bot.py --dev`. Telegram allows
# only one poller per token, so testing locally against the deployed bot's
# token makes the two evict each other. Not needed on the host.
DEV_BOT_TOKEN=paste-here

# Where the SQLite file lives (saved branches, Instamart store ids, pick
# history). The default is fine locally. On a hosted container the filesystem
# is ephemeral, so point this at a mounted volume or every redeploy wipes it:
#   DB_PATH=/data/bot.db
